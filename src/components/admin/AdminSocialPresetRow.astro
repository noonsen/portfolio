---
import BrandIcon from '../BrandIcon.astro';
import AdminIcon from './AdminIcon.astro';
import { ADMIN_SOCIAL_ORDER_MAX } from '../../lib/admin-console/theme-shared';

interface Props {
  row: {
    id: 'github' | 'x' | 'email';
    label: string;
    orderInputId: string;
    inputId: string;
    inputType: 'url' | 'email';
    inputMode: 'url' | 'email';
    autoComplete: string;
    placeholder: string;
  };
}

const { row } = Astro.props;
const visibilityLabel = `Hide ${row.label}`;
const removeLabel = `${row.label} is a fixed entry and cannot be removed`;
---

<article class="admin-row admin-row--interactive admin-row--table admin-social-row admin-social-row--preset" data-social-preset-row data-social-preset-id={row.id}>
  <label class="admin-field admin-social-field admin-social-field--order">
    <span class="admin-social-cell-label">Position</span>
    <span class="admin-social-order-frame">
      <span class="admin-social-order-frame__mark" aria-hidden="true">[</span>
      <input
        class="admin-field__control"
        id={row.orderInputId}
        data-social-preset-field="order"
        type="number"
        min="1"
        max={String(ADMIN_SOCIAL_ORDER_MAX)}
        step="1"
        inputmode="numeric"
        aria-label={`${row.label} position order`}
      />
      <span class="admin-social-order-frame__mark" aria-hidden="true">]</span>
    </span>
  </label>

  <div class="admin-field admin-social-field admin-social-field--platform admin-social-field--static">
    <span class="admin-social-cell-label">Platform</span>
    <input
      class="admin-field__control admin-social-static-input"
      name={`site-social-${row.id}-platform-display`}
      type="text"
      value={row.label}
      readonly
      tabindex="-1"
    />
  </div>

  <div class="admin-social-field admin-social-field--icon admin-social-field--static">
    <span class="admin-social-cell-label">Icon</span>
    <div class="admin-social-icon-preview">
      <span class="admin-social-icon-only">
        <BrandIcon name={row.id} class="admin-social-icon-only__icon" size={16} />
      </span>
    </div>
  </div>

  <label class="admin-field admin-social-field admin-social-field--href">
    <span class="admin-social-cell-label">{row.id === 'email' ? 'Email address' : 'Link URL'}</span>
    <input
      class="admin-field__control admin-field__control--soft"
      id={row.inputId}
      data-social-preset-field="href"
      type={row.inputType}
      inputmode={row.inputMode}
      autocomplete={row.autoComplete}
      placeholder={row.placeholder}
    />
  </label>

  <div class="admin-field admin-social-field admin-social-field--actions admin-social-field--static">
    <span class="admin-social-cell-label">Actions</span>
    <div class="admin-social-row-actions">
      <button
        class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-social-action"
        type="button"
        data-social-preset-action="toggle-visible"
        aria-pressed="true"
        aria-label={visibilityLabel}
        title={visibilityLabel}
      >
        <AdminIcon name="eye" class="admin-social-action__icon" size={15} />
        <span class="sr-only">{visibilityLabel}</span>
      </button>
      <button
        class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-social-action admin-social-action--disabled"
        type="button"
        data-social-preset-action="remove"
        aria-label={removeLabel}
        title={removeLabel}
        disabled
      >
        <AdminIcon name="trash" class="admin-social-action__icon" size={15} />
        <span class="sr-only">{removeLabel}</span>
      </button>
    </div>
  </div>
</article>
